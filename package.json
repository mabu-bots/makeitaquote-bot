{
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "discord.js": "^14.25.1"
  },
  "description": "メッセージや任意のテキストから「名言風」捏造画像を生成する Discord Bot (Make It a Quote 形式)",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "dist/src/index.js",
  "name": "makeitaquote-bot",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "deploy": "node --env-file=.env dist/src/deploy.js",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"package.json\" \"tsconfig.json\" \"ecosystem.config.cjs\" \".github/workflows/*.yml\" \".github/dependabot.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"package.json\" \"tsconfig.json\" \"ecosystem.config.cjs\" \".github/workflows/*.yml\" \".github/dependabot.yml\"",
    "sample": "node dist/src/sample.js",
    "start": "node --env-file=.env dist/src/index.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "type": "module",
  "version": "1.0.0"
}
