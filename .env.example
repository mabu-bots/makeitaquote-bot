# Discord アプリの Bot トークン (Developer Portal の Bot ページで取得)
DISCORD_TOKEN=
# アプリケーション ID (Developer Portal の General Information)
CLIENT_ID=
# (任意) 設定すると、そのサーバーだけにコマンドを登録します (即時反映)。
# 空の場合はグローバル登録になり、反映まで最大1時間かかります。
GUILD_ID=
# (任意) 生成画像のアーカイブ保存を止める場合は off
# QUOTE_ARCHIVE=off
# (任意) アーカイブの保存先 (既定: data/archive)
# QUOTE_ARCHIVE_DIR=
